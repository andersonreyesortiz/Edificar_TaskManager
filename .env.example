# Base de datos PostgreSQL (Neon). Usa la URL "pooled" en DATABASE_URL y la directa en DIRECT_URL.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/ritmo?sslmode=require"
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/ritmo?sslmode=require"

# Secreto para firmar las sesiones. Genera uno con: npx auth secret
AUTH_SECRET=""

# Inicio de sesión con Google (Google Cloud Console > APIs y servicios > Credenciales)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Enlace de acceso por correo para invitados sin Google (https://resend.com). Opcional.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Ritmo <no-reply@tudominio.com>"

# Dominios de la empresa cuyos correos pueden entrar sin invitación (separados por coma)
ALLOWED_DOMAINS="edificaronline.com"
# Correos que entran como administradores
ADMIN_EMAILS="tu.correo@edificaronline.com"

# Zona horaria para mostrar fechas y horas
NEXT_PUBLIC_APP_TIMEZONE="America/Guatemala"

# URL pública de la app (para los enlaces de invitación)
APP_URL="https://tu-app.vercel.app"

# Acceso de prueba sin contraseña. SOLO en desarrollo, nunca en producción.
AUTH_DEV_LOGIN="false"
